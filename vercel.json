{
  "cleanUrls": true,
  "installCommand": "npm install",
  "buildCommand": "sed -i \"s/REPLACE_WITH_FIREBASE_KEY/$FIREBASE_API_KEY/g\" js/config.js && sed -i \"s/REPLACE_WITH_RZP_SECRET/$RAZORPAY_SECRET/g\" api/create-order.js",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/home",
      "destination": "/pages/home.html"
    },
    {
      "source": "/pricing",
      "destination": "/pages/pricing.html"
    },
    {
      "source": "/((?!api|pages|css|js|Images|legal).*)",
      "destination": "/pages/home.html"
    }
  ]
}